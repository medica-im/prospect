# Django
# Generate with: ./scripts/gen-secret-key.sh
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_PORT=8000

# Public base URL of this app. Used to build the absolute unsubscribe links that
# go inside outgoing emails, so it MUST be reachable by email recipients.
SITE_URL=http://localhost:8000
# Base URL used for admin links inside error messages
ADMIN_BASE_URL=http://prospect.localhost

# PostgreSQL
POSTGRES_DB=prospect
POSTGRES_USER=prospect
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_MANAGEMENT_PORT=15672

# Celery
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Mailgun
MAILGUN_API_URL=
MAILGUN_SENDING_KEY_ID=
MAILGUN_SENDING_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=

# Twenty CRM
TWENTY_API_URL=
TWENTY_API_KEY=

# IMAP (Dovecot)
IMAP_SERVER=
IMAP_EMAIL=
IMAP_PASSWORD=

# Where collectstatic writes. Must sit outside $HOME (0700) so nginx can read it.
DJANGO_STATIC_ROOT=/srv/static
DJANGO_STATIC_ROOT_HOST=/srv/dev.prospect.medica.im/static

# Django 4+ checks Origin against this on every HTTPS POST (admin login included).
# Must list the externally reachable origin, scheme included.
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
