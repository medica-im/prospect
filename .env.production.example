# Django
# Generate with: ./scripts/gen-secret-key.sh
DJANGO_SECRET_KEY=generate-a-long-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=prospect.yourdomain.com,web
CSRF_TRUSTED_ORIGINS=https://prospect.yourdomain.com
CORS_ALLOWED_ORIGINS=https://prospect.yourdomain.com

# Public base URL of this app. Used to build the absolute unsubscribe links that
# go inside outgoing emails, so it MUST be reachable by email recipients.
SITE_URL=https://prospect.yourdomain.com
# Base URL used for admin links inside error messages
ADMIN_BASE_URL=https://prospect.yourdomain.com

# PostgreSQL
POSTGRES_DB=prospect
POSTGRES_USER=prospect
POSTGRES_PASSWORD=generate-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DATA=

# RabbitMQ
RABBITMQ_USER=prospect
RABBITMQ_PASSWORD=generate-a-strong-password

# Ports (localhost only, for external nginx)
DJANGO_PORT=8000
FRONTEND_PORT=3000

# Celery (CELERY_BROKER_URL is set in docker-compose from RABBITMQ_USER/PASSWORD)
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Mailgun
MAILGUN_API_URL=https://api.eu.mailgun.net/v3/mail.yourdomain.com/messages
MAILGUN_SENDING_KEY_ID=
MAILGUN_SENDING_KEY=
MAILGUN_DOMAIN=mail.yourdomain.com
MAILGUN_FROM_EMAIL=Your Name <noreply@mail.yourdomain.com>

# Twenty CRM
TWENTY_API_URL=https://twenty.yourdomain.com
TWENTY_API_KEY=

# IMAP (Dovecot)
IMAP_SERVER=mail.yourdomain.com
IMAP_EMAIL=
IMAP_PASSWORD=

# Images pulled by docker-compose-production.yml, built and pushed from a dev
# machine with ./scripts/build-image.sh all — production pulls, it never builds.
#
# Pin to the immutable :<sha> tag that the script prints, not :production. Both
# are pushed, but :production moves with every release, so a pinned sha is what
# makes a rollback possible: put the previous one back and re-up.
FRONTEND_IMAGE=ghcr.io/medica-im/prospect-frontend:production
BACKEND_IMAGE=ghcr.io/medica-im/prospect-backend:production

# Where collectstatic writes. The release service writes it, web mounts it
# read-only, and nginx serves it directly from DJANGO_STATIC_ROOT_HOST.
#
# _HOST must match the `alias` in the nginx vhost's `location /static/` block —
# they are two halves of one path and a mismatch is a silent 404 on every admin
# asset. On prospect.medica.im that alias is /var/lib/prospect/static/.
#
# Outside /opt/prospect on purpose: that directory is a git checkout (it is
# where the compose files are pulled from), and collectstatic output written
# inside it shows up as untracked cruft in `git status` and risks colliding
# with a future pull. /var/lib is the FHS location for application state, and
# /var/lib/prospect is 755 root:root so www-data can traverse to the files.
DJANGO_STATIC_ROOT_HOST=/var/lib/prospect/static
# Path inside the container. Arbitrary, but must match on both services.
DJANGO_STATIC_ROOT=/app/staticfiles
